{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc",
    "prepare": "lefthook install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc && oxlint && oxfmt --check"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.0-rc.14",
    "solid-js": "^2.0.0-rc.14"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.49",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "eslint-plugin-solid": "^0.18.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "bun@1.4.3"
}
