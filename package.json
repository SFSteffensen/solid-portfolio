{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun check --no-script && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun check --no-script",
    "prepare": "lefthook install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun check --no-script && oxlint && bun fmt --check"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "eslint-plugin-solid": "^0.20.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  },
  "packageManager": "bun@1.4.4"
}
