{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun check --no-script && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun check --no-script",
    "prepare": "lefthook install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun check --no-script && oxlint && bun fmt --check"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.0-rc.14",
    "solid-js": "^2.0.0-rc.21"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.49",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "eslint-plugin-solid": "^0.18.1",
    "lefthook": "^2.2.1",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "bun@1.4.4"
}
